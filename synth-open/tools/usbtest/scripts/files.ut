# File commands. The runner or the e2e script creates payload.bin in the output folder first (random bytes).
ls /
put payload.bin /usbtest/payload.bin
ls /usbtest
hash-file /usbtest/payload.bin
get /usbtest/payload.bin got.bin
rm /usbtest/payload.bin
ls /usbtest
raw get /usbtest/payload.bin
raw rm /usbtest/payload.bin
