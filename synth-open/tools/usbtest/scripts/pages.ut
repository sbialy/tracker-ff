# Page walk: every top row page, its texts and its tile CRCs. Record the CRCs once on a known good build with
#   usbtest.py ... --out golden scripts/pages.ut        then compare later runs with the files in golden/
# (the shotcrc-expect lines are commented out until golden/*.json exist).
tap Master
idle
wait 800
expect page master
shotcrc master
shotcrc-save master pages_master.json
tap Song
idle
wait 800
expect page song
shotcrc song
shotcrc-save song pages_song.json
tap Config
idle
wait 800
expect page config
shotcrc config
shotcrc-save config pages_config.json
tap Pattern
idle
wait 800
expect page pattern
shotcrc pattern
shotcrc-save pattern pages_pattern.json
